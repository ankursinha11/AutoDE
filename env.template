# ========================================
# MINIMAL CONFIGURATION FOR YOUR SETUP
# Copy this to .env and fill in your values
# ========================================

# Required: Azure OpenAI Configuration (LLM - GPT Models)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR-API-KEY-HERE
AZURE_OPENAI_DEPLOYMENT_NAME=YOUR-GPT4-DEPLOYMENT-NAME
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ========================================
# EMBEDDINGS CONFIGURATION (Separate Resource Group Support)
# ========================================
# Option 1: Use SAME resource group as LLM (default)
# Just specify the deployment name, it will use the same endpoint/key from above
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=YOUR-EMBEDDING-DEPLOYMENT-NAME

# Option 2: Use DIFFERENT resource group for embeddings
# Uncomment these if your embeddings are in a different Azure resource group
# AZURE_EMBEDDINGS_ENDPOINT=https://YOUR-EMBEDDINGS-RESOURCE.openai.azure.com/
# AZURE_EMBEDDINGS_API_KEY=YOUR-EMBEDDINGS-API-KEY
# AZURE_EMBEDDINGS_DEPLOYMENT=text-embedding-3-large
# AZURE_EMBEDDINGS_API_VERSION=2024-02-15-preview

# Note: If you use a different resource group, the system will:
# - Use AZURE_OPENAI_* for LLM (GPT-4o, GPT-5-codex, etc.)
# - Use AZURE_EMBEDDINGS_* for embeddings (text-embedding-3-large, ada-002, etc.)

# Local Storage (default - no changes needed)
OUTPUT_DIR=./outputs
LOG_LEVEL=INFO

# ========================================
# YOU DON'T NEED THESE (commented out):
# ========================================
# AZURE_SEARCH_ENDPOINT=...  # NOT NEEDED - using ChromaDB instead!
# AZURE_SEARCH_API_KEY=...   # NOT NEEDED - using ChromaDB instead!
# AZURE_STORAGE_CONNECTION_STRING=...  # NOT NEEDED - using local storage!
